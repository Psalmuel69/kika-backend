FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force
COPY src ./src
COPY assets ./assets

FROM node:20-bookworm-slim
WORKDIR /app

# See Dockerfile's comment on this block — fontconfig itself (not just
# libvips) is required for any receipt text to render at all.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips42 \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system kika && adduser --system --ingroup kika kika

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/src ./src
COPY --from=build /app/assets ./assets
COPY package.json ./

RUN mkdir -p /data/receipts && chown -R kika:kika /data/receipts /app

USER kika

ENV NODE_ENV=production \
    RECEIPT_STORAGE_DIR=/data/receipts

# The worker has no HTTP server to health-check (unlike the api image —
# see Dockerfile), so this checks the one thing that actually matters
# for it to be useful: can it reach Redis, where BullMQ's queue lives.
# Reuses the same REDIS_URL env var the app itself connects with, so
# this checks the real configured target (Upstash in production) rather
# than a hardcoded local address.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "const R=require('ioredis'); const c=new R(process.env.REDIS_URL,{maxRetriesPerRequest:1,lazyConnect:true}); c.connect().then(()=>c.ping()).then(()=>{c.disconnect();process.exit(0)}).catch(()=>process.exit(1))"

CMD ["node", "src/queue/worker.js"]
